# Neon PostgreSQL connection string (pooled)
# This is the main database connection with connection pooling
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon PostgreSQL direct connection string (unpooled)
# Required for Prisma migrations and some database operations
# Get this from your Neon dashboard - usually the same as DATABASE_URL but without ?pgbouncer=true
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
