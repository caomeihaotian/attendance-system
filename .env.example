# Neon PostgreSQL connection string (pooled)
# This is the main database connection with connection pooling
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon PostgreSQL direct connection string (unpooled)
# Required for Prisma migrations and some database operations
# Get this from your Neon dashboard - usually the same as DATABASE_URL but without ?pgbouncer=true
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# JWT Secret for password reset tokens
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-change-in-production-use-openssl-rand-base64-32"

# Email Service (Resend) - For password reset via email
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY="re_xxxxxxxxxxxxx"
# RESEND_FROM_EMAIL="noreply@yourdomain.com"

# SMS Service (Tencent Cloud) - For password reset via phone
# Configure at https://console.cloud.tencent.com/sms
# TENCENT_SECRET_ID="your-secret-id"
# TENCENT_SECRET_KEY="your-secret-key"
# TENCENT_SMS_APP_ID="your-app-id"
# TENCENT_SMS_TEMPLATE_ID="your-template-id"
# TENCENT_SMS_SIGN_NAME="your-sign-name"
# TENCENT_SMS_REGION="ap-guangzhou"
# TENCENT_SMS_SUCCESS_TEMPLATE_ID="your-success-template-id"
